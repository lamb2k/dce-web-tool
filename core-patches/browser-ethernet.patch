--- /dev/null
+++ b/core/network/browser_ethernet.cpp
@@ -0,0 +1,58 @@
+// Emscripten-only guest Ethernet seam. Native Flycast services unchanged.
+#ifdef __EMSCRIPTEN__
+#include "browser_ethernet.h"
+#include "browser_ethernet_queue.h"
+#include "hw/bba/bba.h"
+#include "cfg/option.h"
+#include <emscripten.h>
+namespace {
+halo_browser::Queue rx;
+std::array<uint8_t, halo_browser::MaxFrame> staging{};
+bool started = false;
+bool notifyingStop = false;
+uint32_t txDropped = 0;
+EM_JS(int, browser_tx, (const uint8_t* p, unsigned n, uint32_t generation), {
+    const bridge = Module.haloEthernet;
+    return bridge && bridge.send ? bridge.send(HEAPU8.slice(p,p+n),generation) : 0;
+});
+EM_JS(void, browser_stop, (uint32_t generation), {
+    const bridge = Module.haloEthernet;
+    if (bridge && bridge.coreStopped) bridge.coreStopped(generation);
+});
+}
+extern "C" {
+EMSCRIPTEN_KEEPALIVE uint32_t halo_eth_configure() { return notifyingStop ? 0 : rx.configure(); }
+EMSCRIPTEN_KEEPALIVE uint8_t* halo_eth_rx_buffer() { return staging.data(); }
+EMSCRIPTEN_KEEPALIVE int halo_eth_rx(uint32_t gen, unsigned length) {
+    if (!started || !config::EmulateBBA) { ++rx.dropped; return 0; }
+    return rx.push(gen,staging.data(),length,emscripten_get_now());
+}
+EMSCRIPTEN_KEEPALIVE void halo_eth_stop() {
+    rx.stop();
+    if (!notifyingStop) {
+        notifyingStop = true;
+        browser_stop(rx.generation);
+        notifyingStop = false;
+    }
+}
+EMSCRIPTEN_KEEPALIVE uint32_t halo_eth_metric(unsigned id) {
+    switch(id) { case 0:return rx.generation; case 1:return rx.count; case 2:return rx.bytes;
+        case 3:return rx.highWater; case 4:return rx.dropped; case 5:return txDropped;
+        case 6:return sizeof(rx)+sizeof(staging)+sizeof(started)+sizeof(notifyingStop)+sizeof(txDropped);
+        case 7:return started; case 8:return rx.ready;
+        default:return 0; }
+}
+}
+namespace net::modbba {
+bool BrowserEthernetService::start() { started=config::EmulateBBA; return started && rx.ready; }
+void BrowserEthernetService::stop() { browserEthernetInvalidate(); }
+void BrowserEthernetService::receiveEthFrame(const u8* p,u32 n) {
+    if (!started || !config::EmulateBBA || !rx.ready || !halo_browser::validFrame(p,n) || !browser_tx(p,n,rx.generation)) ++txDropped;
+}
+void browserEthernetDrain() {
+    if (started && config::EmulateBBA)
+        rx.drain(emscripten_get_now(),[](const uint8_t* p,unsigned n){return bba_recv_frame(p,n)!=0;});
+}
+void browserEthernetInvalidate() { started=false; halo_eth_stop(); }
+}
+#endif
