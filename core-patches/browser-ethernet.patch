@@ -0,0 +1,40 @@
+#pragma once
+#include <array>
+#include <cstdint>
+#include <cstring>
+namespace halo_browser {
+constexpr unsigned MaxFrame = 1514, MaxFrames = 32, MaxBytes = 48 * 1024;
+constexpr double MaxAgeMs = 1000;
+inline bool validFrame(const uint8_t* p, unsigned n) {
+    return p && n >= 14 && n <= MaxFrame &&
+        ((p[12] == 8 && p[13] == 0) || (p[12] == 8 && p[13] == 6));
+}
+struct Frame { std::array<uint8_t, MaxFrame> bytes{}; uint16_t length = 0; double time = 0; };
+struct Queue {
+    std::array<Frame, MaxFrames> frames{};
+    uint32_t generation = 1, dropped = 0, highWater = 0;
+    unsigned head = 0, count = 0, bytes = 0;
+    bool ready = false;
+    void clear() { head = count = bytes = 0; }
+    void stop() { ready = false; clear(); if (++generation == 0) ++generation; }
+    uint32_t configure() { stop(); ready = true; return generation; }
+    bool push(uint32_t gen, const uint8_t* p, unsigned n, double now) {
+        if (!ready || gen != generation || !validFrame(p,n) || count == MaxFrames || bytes+n > MaxBytes) {
+            ++dropped; return false;
+        }
+        auto& f = frames[(head+count)%MaxFrames];
+        std::memcpy(f.bytes.data(),p,n); f.length=n; f.time=now;
+        bytes += n; ++count; if (count>highWater) highWater=count; return true;
+    }
+    void pop() { if (count) { bytes -= frames[head].length; head=(head+1)%MaxFrames; --count; } }
+    template<class Deliver> void drain(double now, Deliver deliver) {
+        unsigned budget=MaxFrames;
+        while (ready && count && budget--) {
+            auto& f=frames[head];
+            if (now-f.time > MaxAgeMs || now < f.time) { ++dropped; pop(); continue; }
+            if (!deliver(f.bytes.data(),f.length)) break;
+            pop();
+        }
+    }
+};
+}
